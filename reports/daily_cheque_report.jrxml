<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="daily_cheque_report"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="7f2b5f5e-8c7c-4a5f-9e6b-1c2d3f4a5b6c">

    <parameter name="P_PROCESSING_DATE" class="java.sql.Date"/>

    <queryString language="SQL"><![CDATA[
        SELECT cheque_number, customer_name, bank_name,
               cheque_amount, batch_id, status
        FROM cheque_transaction
        WHERE processing_date = $P{P_PROCESSING_DATE}
        ORDER BY cheque_number
    ]]></queryString>

    <field name="cheque_number" class="java.lang.String"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="bank_name" class="java.lang.String"/>
    <field name="cheque_amount" class="java.math.BigDecimal"/>
    <field name="batch_id" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <variable name="TotalChequesProcessed"
              class="java.lang.Integer"
              calculation="Count">
        <variableExpression><![CDATA[$F{cheque_number}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <variable name="TotalProcessingAmount"
              class="java.math.BigDecimal"
              calculation="Sum">
        <variableExpression><![CDATA[$F{cheque_amount}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal("0.00")]]></initialValueExpression>
    </variable>

    <style name="TitleStyle"
           fontName="SansSerif"
           fontSize="18"
           isBold="true"
           forecolor="#1F4E78"/>

    <style name="HeaderStyle"
           fontName="SansSerif"
           fontSize="10"
           isBold="true"
           forecolor="#FFFFFF"
           backcolor="#1F4E78"
           hTextAlign="Center"
           vTextAlign="Middle"/>

    <style name="DetailStyle"
           fontName="SansSerif"
           fontSize="9"
           vTextAlign="Middle"/>

    <style name="FooterStyle"
           fontName="SansSerif"
           fontSize="11"
           isBold="true"
           forecolor="#1F1F1F"/>

    <title>
        <band height="70">
            <element kind="staticText"
                     x="0" y="0" width="555" height="28"
                     style="TitleStyle"
                     hTextAlign="Center"
                     vTextAlign="Middle"
                     uuid="11111111-1111-1111-1111-111111111111">
                <text><![CDATA[DAILY CHEQUE PROCESSING REPORT]]></text>
            </element>

            <element kind="textField"
                     x="0" y="32" width="555" height="20"
                     hTextAlign="Center"
                     vTextAlign="Middle"
                     uuid="22222222-2222-2222-2222-222222222222">
                <expression><![CDATA[
                    "Processing Date: " +
                    new java.text.SimpleDateFormat("dd-MM-yyyy").format($P{P_PROCESSING_DATE})
                ]]></expression>
            </element>

            <element kind="line"
                     x="0" y="62" width="555" height="1"
                     forecolor="#1F4E78"
                     uuid="33333333-3333-3333-3333-333333333333"/>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <element kind="staticText" x="0" y="0" width="80" height="30"
                     style="HeaderStyle" uuid="44444444-4444-4444-4444-444444444444">
                <text><![CDATA[Cheque No]]></text>
            </element>

            <element kind="staticText" x="80" y="0" width="115" height="30"
                     style="HeaderStyle" uuid="55555555-5555-5555-5555-555555555555">
                <text><![CDATA[Customer]]></text>
            </element>

            <element kind="staticText" x="195" y="0" width="115" height="30"
                     style="HeaderStyle" uuid="66666666-6666-6666-6666-666666666666">
                <text><![CDATA[Bank]]></text>
            </element>

            <element kind="staticText" x="310" y="0" width="80" height="30"
                     style="HeaderStyle" uuid="77777777-7777-7777-7777-777777777777">
                <text><![CDATA[Amount]]></text>
            </element>

            <element kind="staticText" x="390" y="0" width="75" height="30"
                     style="HeaderStyle" uuid="88888888-8888-8888-8888-888888888888">
                <text><![CDATA[Batch]]></text>
            </element>

            <element kind="staticText" x="465" y="0" width="90" height="30"
                     style="HeaderStyle" uuid="99999999-9999-9999-9999-999999999999">
                <text><![CDATA[Status]]></text>
            </element>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <element kind="textField" x="0" y="0" width="80" height="25"
                     style="DetailStyle"
                     hTextAlign="Center"
                     vTextAlign="Middle"
                     uuid="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa">
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <expression><![CDATA[$F{cheque_number}]]></expression>
            </element>

            <element kind="textField" x="80" y="0" width="115" height="25"
                     style="DetailStyle"
                     vTextAlign="Middle"
                     uuid="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb">
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <expression><![CDATA[$F{customer_name}]]></expression>
            </element>

            <element kind="textField" x="195" y="0" width="115" height="25"
                     style="DetailStyle"
                     vTextAlign="Middle"
                     uuid="cccccccc-cccc-cccc-cccc-cccccccccccc">
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <expression><![CDATA[$F{bank_name}]]></expression>
            </element>

            <element kind="textField" x="310" y="0" width="80" height="25"
                     style="DetailStyle"
                     hTextAlign="Right"
                     vTextAlign="Middle"
                     pattern="#,##0.00"
                     uuid="dddddddd-dddd-dddd-dddd-dddddddddddd">
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <expression><![CDATA[$F{cheque_amount}]]></expression>
            </element>

            <element kind="textField" x="390" y="0" width="75" height="25"
                     style="DetailStyle"
                     hTextAlign="Center"
                     vTextAlign="Middle"
                     uuid="eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee">
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <expression><![CDATA[$F{batch_id}]]></expression>
            </element>

            <element kind="textField" x="465" y="0" width="90" height="25"
                     style="DetailStyle"
                     hTextAlign="Center"
                     vTextAlign="Middle"
                     uuid="ffffffff-ffff-ffff-ffff-ffffffffffff">
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <expression><![CDATA[$F{status}]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <element kind="textField"
                     x="0" y="5" width="400" height="15"
                     vTextAlign="Middle"
                     uuid="12121212-1212-1212-1212-121212121212">
                <expression><![CDATA["CTS Reporting System"]]></expression>
            </element>

            <element kind="textField"
                     x="400" y="5" width="155" height="15"
                     hTextAlign="Right"
                     vTextAlign="Middle"
                     uuid="13131313-1313-1313-1313-131313131313">
                <expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression>
            </element>
        </band>
    </pageFooter>

    <summary>
        <band height="70">
            <element kind="line"
                     x="0" y="5" width="555" height="1"
                     forecolor="#1F4E78"
                     uuid="14141414-1414-1414-1414-141414141414"/>

            <element kind="staticText"
                     x="0" y="15" width="300" height="25"
                     style="FooterStyle"
                     vTextAlign="Middle"
                     uuid="15151515-1515-1515-1515-151515151515">
                <text><![CDATA[Total Cheques Processed:]]></text>
            </element>

            <element kind="textField"
                     x="300" y="15" width="100" height="25"
                     style="FooterStyle"
                     vTextAlign="Middle"
                     uuid="16161616-1616-1616-1616-161616161616">
                <expression><![CDATA[$V{TotalChequesProcessed}]]></expression>
            </element>

            <element kind="staticText"
                     x="0" y="42" width="300" height="20"
                     style="FooterStyle"
                     vTextAlign="Middle"
                     uuid="17171717-1717-1717-1717-171717171717">
                <text><![CDATA[Total Processing Amount:]]></text>
            </element>

            <element kind="textField"
                     x="300" y="42" width="150" height="20"
                     style="FooterStyle"
                     hTextAlign="Left"
                     vTextAlign="Middle"
                     pattern="#,##0.00"
                     uuid="18181818-1818-1818-1818-181818181818">
                <expression><![CDATA[$V{TotalProcessingAmount}]]></expression>
            </element>
        </band>
    </summary>

</jasperReport>