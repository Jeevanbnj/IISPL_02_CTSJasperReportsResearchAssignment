<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="daily_cheque_report"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="7f2b5f5e-8c7c-4a5f-9e6b-1c2d3f4a5b6c">

   

    <parameter name="P_PROCESSING_DATE" class="java.sql.Date"/>

    

    <queryString language="SQL">
        <![CDATA[
            SELECT
                cheque_number,
                customer_name,
                bank_name,
                cheque_amount,
                batch_id,
                status
            FROM cheque_transaction
            WHERE processing_date = $P{P_PROCESSING_DATE}
            ORDER BY cheque_number
        ]]>
    </queryString>

    

    <field name="cheque_number" class="java.lang.String"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="bank_name" class="java.lang.String"/>
    <field name="cheque_amount" class="java.math.BigDecimal"/>
    <field name="batch_id" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    
    <variable
        name="TotalChequesProcessed"
        class="java.lang.Integer"
        calculation="Count">
        <variableExpression><![CDATA[$F{cheque_number}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <variable
        name="TotalProcessingAmount"
        class="java.math.BigDecimal"
        calculation="Sum">
        <variableExpression><![CDATA[$F{cheque_amount}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal("0.00")]]></initialValueExpression>
    </variable>

    

    <style
        name="TitleStyle"
        fontName="SansSerif"
        fontSize="18"
        isBold="true"
        forecolor="#1F4E78"/>

    <style
        name="HeaderStyle"
        fontName="SansSerif"
        fontSize="10"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#1F4E78"
        hTextAlign="Center"
        vTextAlign="Middle"/>

    <style
        name="DetailStyle"
        fontName="SansSerif"
        fontSize="9"
        vTextAlign="Middle"/>

    <style
        name="FooterStyle"
        fontName="SansSerif"
        fontSize="11"
        isBold="true"
        forecolor="#1F1F1F"/>

    

    <title>
        <band height="70">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="555"
                    height="28"
                    uuid="11111111-1111-1111-1111-111111111111"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[DAILY CHEQUE PROCESSING REPORT]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="0"
                    y="32"
                    width="555"
                    height="20"
                    uuid="22222222-2222-2222-2222-222222222222"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    "Processing Date: " +
                    new java.text.SimpleDateFormat("dd-MM-yyyy")
                        .format($P{P_PROCESSING_DATE})
                ]]></textFieldExpression>
            </textField>

            <line>
                <reportElement
                    x="0"
                    y="62"
                    width="555"
                    height="1"
                    forecolor="#1F4E78"
                    uuid="33333333-3333-3333-3333-333333333333"/>
            </line>

        </band>
    </title>

    

    <columnHeader>
        <band height="30">

            <!-- Cheque No -->
            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="80"
                    height="30"
                    style="HeaderStyle"
                    uuid="44444444-4444-4444-4444-444444444444"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Cheque No]]></text>
            </staticText>

            <!-- Customer -->
            <staticText>
                <reportElement
                    x="80"
                    y="0"
                    width="115"
                    height="30"
                    style="HeaderStyle"
                    uuid="55555555-5555-5555-5555-555555555555"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Customer]]></text>
            </staticText>

            <!-- Bank -->
            <staticText>
                <reportElement
                    x="195"
                    y="0"
                    width="115"
                    height="30"
                    style="HeaderStyle"
                    uuid="66666666-6666-6666-6666-666666666666"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Bank]]></text>
            </staticText>

            <!-- Amount -->
            <staticText>
                <reportElement
                    x="310"
                    y="0"
                    width="80"
                    height="30"
                    style="HeaderStyle"
                    uuid="77777777-7777-7777-7777-777777777777"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Amount]]></text>
            </staticText>

            <!-- Batch -->
            <staticText>
                <reportElement
                    x="390"
                    y="0"
                    width="75"
                    height="30"
                    style="HeaderStyle"
                    uuid="88888888-8888-8888-8888-888888888888"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Batch]]></text>
            </staticText>

            <!-- Status -->
            <staticText>
                <reportElement
                    x="465"
                    y="0"
                    width="90"
                    height="30"
                    style="HeaderStyle"
                    uuid="99999999-9999-9999-9999-999999999999"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Status]]></text>
            </staticText>

        </band>
    </columnHeader>

    

    <detail>
        <band height="25">

            <!-- Cheque Number -->
            <textField>
                <reportElement
                    x="0"
                    y="0"
                    width="80"
                    height="25"
                    style="DetailStyle"
                    uuid="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{cheque_number}
                ]]></textFieldExpression>
            </textField>

            <!-- Customer -->
            <textField isBlankWhenNull="true">
                <reportElement
                    x="80"
                    y="0"
                    width="115"
                    height="25"
                    style="DetailStyle"
                    uuid="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <textElement
                    textAlignment="Left"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{customer_name}
                ]]></textFieldExpression>
            </textField>

            <!-- Bank -->
            <textField isBlankWhenNull="true">
                <reportElement
                    x="195"
                    y="0"
                    width="115"
                    height="25"
                    style="DetailStyle"
                    uuid="cccccccc-cccc-cccc-cccc-cccccccccccc"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <textElement
                    textAlignment="Left"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{bank_name}
                ]]></textFieldExpression>
            </textField>

            <!-- Amount -->
            <textField pattern="#,##0.00">
                <reportElement
                    x="310"
                    y="0"
                    width="80"
                    height="25"
                    style="DetailStyle"
                    uuid="dddddddd-dddd-dddd-dddd-dddddddddddd"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{cheque_amount}
                ]]></textFieldExpression>
            </textField>

            <!-- Batch -->
            <textField>
                <reportElement
                    x="390"
                    y="0"
                    width="75"
                    height="25"
                    style="DetailStyle"
                    uuid="eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{batch_id}
                ]]></textFieldExpression>
            </textField>

            <!-- Status -->
            <textField>
                <reportElement
                    x="465"
                    y="0"
                    width="90"
                    height="25"
                    style="DetailStyle"
                    uuid="ffffffff-ffff-ffff-ffff-ffffffffffff"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D9E2F3"/>
                </box>
                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{status}
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    

    <pageFooter>
        <band height="25">

            <textField>
                <reportElement
                    x="0"
                    y="5"
                    width="400"
                    height="15"
                    uuid="12121212-1212-1212-1212-121212121212"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    "CTS Reporting System"
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                    x="400"
                    y="5"
                    width="155"
                    height="15"
                    uuid="13131313-1313-1313-1313-131313131313"/>
                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    

    <summary>
        <band height="70">

            <line>
                <reportElement
                    x="0"
                    y="5"
                    width="555"
                    height="1"
                    forecolor="#1F4E78"
                    uuid="14141414-1414-1414-1414-141414141414"/>
            </line>

            <!-- Total Cheques Processed -->
            <staticText>
                <reportElement
                    x="0"
                    y="15"
                    width="300"
                    height="25"
                    style="FooterStyle"
                    uuid="15151515-1515-1515-1515-151515151515"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Total Cheques Processed:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="300"
                    y="15"
                    width="100"
                    height="25"
                    style="FooterStyle"
                    uuid="16161616-1616-1616-1616-161616161616"/>
                <textElement
                    textAlignment="Left"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $V{TotalChequesProcessed}
                ]]></textFieldExpression>
            </textField>

            <!-- Total Processing Amount -->
            <staticText>
                <reportElement
                    x="0"
                    y="42"
                    width="300"
                    height="20"
                    style="FooterStyle"
                    uuid="17171717-1717-1717-1717-171717171717"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Total Processing Amount:]]></text>
            </staticText>

            <textField pattern="#,##0.00">
                <reportElement
                    x="300"
                    y="42"
                    width="150"
                    height="20"
                    style="FooterStyle"
                    uuid="18181818-1818-1818-1818-181818181818"/>
                <textElement
                    textAlignment="Left"
                    verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $V{TotalProcessingAmount}
                ]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>