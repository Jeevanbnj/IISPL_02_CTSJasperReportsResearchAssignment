<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bank_summary_report"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="c7d6b2a1-5f45-4a87-8c21-1d4a5e7f9b30">

    <property name="com.jaspersoft.studio.data.defaultdataadapter"
              value="One Empty Record"/>

    <!--
        Member 6 - Bank-wise Processing Summary

        Database: PostgreSQL/MySQL-compatible SQL

        Required output:
        - Bank
        - Total Cheques
        - Total Amount
        - Bar chart: Bank vs Total Cheque Amount

        The SQL performs:
        - GROUP BY bank_name
        - COUNT(*) for total cheques
        - SUM(cheque_amount) for total amount
        - ORDER BY total_amount DESC for sorting
    -->

    <queryString language="SQL">
        <![CDATA[
            SELECT
                bank_name,
                COUNT(*) AS total_cheques,
                SUM(cheque_amount) AS total_amount
            FROM cheque_transaction
            GROUP BY bank_name
            ORDER BY total_amount DESC
        ]]>
    </queryString>

    <!-- Fields returned by the query -->
    <field name="bank_name" class="java.lang.String"/>
    <field name="total_cheques" class="java.lang.Long"/>
    <field name="total_amount" class="java.math.BigDecimal"/>

    <!-- Grouping by bank -->
    <group name="BankGroup">
        <groupExpression><![CDATA[$F{bank_name}]]></groupExpression>
    </group>

    <!-- ==================== TITLE ==================== -->

    <title>
        <band height="70">

            <staticText>
                <reportElement x="0"
                               y="5"
                               width="555"
                               height="35"
                               uuid="8f3a1d7b-9b5a-4f4a-9e8c-2d6b7c1a5e10"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="20"
                          isBold="true"/>
                </textElement>

                <text><![CDATA[BANK-WISE PROCESSING SUMMARY]]></text>
            </staticText>

            <staticText>
                <reportElement x="0"
                               y="42"
                               width="555"
                               height="20"
                               uuid="1a2b3c4d-5e6f-4789-9012-3456789abcde"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>

                <text><![CDATA[CTS Cheque Processing Report]]></text>
            </staticText>

        </band>
    </title>

    <!-- ==================== COLUMN HEADER ==================== -->

    <columnHeader>
        <band height="30">

            <!-- Bank -->
            <staticText>
                <reportElement x="0"
                               y="0"
                               width="200"
                               height="30"
                               uuid="11111111-2222-3333-4444-555555555555"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Bank]]></text>
            </staticText>

            <!-- Total Cheques -->
            <staticText>
                <reportElement x="200"
                               y="0"
                               width="155"
                               height="30"
                               uuid="66666666-7777-8888-9999-aaaaaaaaaaaa"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Total Cheques]]></text>
            </staticText>

            <!-- Total Amount -->
            <staticText>
                <reportElement x="355"
                               y="0"
                               width="200"
                               height="30"
                               uuid="bbbbbbbb-cccc-dddd-eeee-ffffffffffff"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Total Amount]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ==================== DETAIL ==================== -->

    <detail>
        <band height="28">

            <!-- Bank Name -->
            <textField>
                <reportElement x="0"
                               y="0"
                               width="200"
                               height="28"
                               uuid="10101010-2020-3030-4040-505050505050"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{bank_name}]]>
                </textFieldExpression>
            </textField>

            <!-- Total Cheques -->
            <textField pattern="#,##0">
                <reportElement x="200"
                               y="0"
                               width="155"
                               height="28"
                               uuid="60606060-7070-8080-9090-a0a0a0a0a0a0"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Right"
                             verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{total_cheques}]]>
                </textFieldExpression>
            </textField>

            <!-- Total Amount -->
            <textField pattern="#,##0.00">
                <reportElement x="355"
                               y="0"
                               width="200"
                               height="28"
                               uuid="b0b0b0b0-c0c0-d0d0-e0e0-f0f0f0f0f0f0"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Right"
                             verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{total_amount}]]>
                </textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ==================== SUMMARY / BAR CHART ==================== -->

    <summary>
        <band height="330">

            <staticText>
                <reportElement x="0"
                               y="20"
                               width="555"
                               height="25"
                               uuid="12121212-3434-5656-7878-909090909090"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="14"
                          isBold="true"/>
                </textElement>

                <text><![CDATA[Bank-wise Total Cheque Amount]]></text>
            </staticText>

            <barChart>

                <chart>

                    <reportElement x="0"
                                   y="50"
                                   width="555"
                                   height="270"
                                   uuid="23232323-4545-6767-8989-a0a0a0a0a0a0"/>

                    <chartTitle position="Top"/>

                    <!-- FIXED: JasperReports expects chartLegend, not legend -->
                    <chartLegend position="Bottom"/>

                </chart>

                <!-- ==================== DATASET ==================== -->

                <categoryDataset>

                    <categorySeries>

                        <!-- Series name -->
                        <seriesExpression>
                            <![CDATA["Total Cheque Amount"]]>
                        </seriesExpression>

                        <!-- X-axis: Bank -->
                        <categoryExpression>
                            <![CDATA[$F{bank_name}]]>
                        </categoryExpression>

                        <!-- Y-axis: Total Amount -->
                        <valueExpression>
                            <![CDATA[$F{total_amount}]]>
                        </valueExpression>

                    </categorySeries>

                </categoryDataset>

                <!-- ==================== BAR PLOT ==================== -->

                <barPlot>

                    <plot/>

                    <itemLabel/>

                    <categoryAxisFormat>
                        <axisFormat/>
                    </categoryAxisFormat>

                    <valueAxisFormat>
                        <axisFormat/>
                    </valueAxisFormat>

                </barPlot>

            </barChart>

        </band>
    </summary>

</jasperReport>