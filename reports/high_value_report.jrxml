<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"

    name="high_value_report"

    pageWidth="842"
    pageHeight="595"

    columnWidth="782"

    leftMargin="30"
    rightMargin="30"
    topMargin="30"
    bottomMargin="30">


    <!-- ================================================= -->
    <!-- 1. PARAMETER                                    -->
    <!-- ================================================= -->

    <parameter
        name="P_MIN_AMOUNT"
        class="java.math.BigDecimal">

        <defaultValueExpression><![CDATA[
            new java.math.BigDecimal("200000")
        ]]></defaultValueExpression>

    </parameter>


    <!-- ================================================= -->
    <!-- 2. SQL QUERY                                    -->
    <!-- ================================================= -->

    <queryString language="SQL"><![CDATA[
        SELECT
            cheque_number,
            customer_name,
            bank_name,
            cheque_amount,
            status
        FROM cheque_transaction
        WHERE cheque_amount >= $P{P_MIN_AMOUNT}
        ORDER BY bank_name, cheque_amount DESC
    ]]></queryString>


    <!-- ================================================= -->
    <!-- 3. FIELDS                                       -->
    <!-- ================================================= -->

    <field
        name="cheque_number"
        class="java.lang.String"/>

    <field
        name="customer_name"
        class="java.lang.String"/>

    <field
        name="bank_name"
        class="java.lang.String"/>

    <field
        name="cheque_amount"
        class="java.math.BigDecimal"/>

    <field
        name="status"
        class="java.lang.String"/>


    <!-- ================================================= -->
    <!-- 4. VARIABLES                                    -->
    <!-- ================================================= -->

    <!-- COUNT TOTAL HIGH VALUE CHEQUES -->

    <variable
        name="TotalHighValueCheques"
        class="java.lang.Integer"
        calculation="Count">

        <variableExpression><![CDATA[
            $F{cheque_number}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            0
        ]]></initialValueExpression>

    </variable>


    <!-- SUM TOTAL HIGH VALUE AMOUNT -->

    <variable
        name="TotalHighValueAmount"
        class="java.math.BigDecimal"
        calculation="Sum">

        <variableExpression><![CDATA[
            $F{cheque_amount}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            new java.math.BigDecimal("0")
        ]]></initialValueExpression>

    </variable>


    <!-- ================================================= -->
    <!-- 5. STYLES                                       -->
    <!-- ================================================= -->

    <!-- Normal header style -->

    <style
        name="HeaderStyle"
        fontName="SansSerif"
        fontSize="10"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#1F4E78"
        hTextAlign="Center"
        vTextAlign="Middle"/>


    <!-- Conditional status style -->

    <style name="StatusStyle">

        <!-- REJECTED -->

        <conditionalStyle>

            <conditionExpression><![CDATA[
                "REJECTED".equals($F{status})
            ]]></conditionExpression>

            <style
                forecolor="#9C0006"
                backcolor="#FFC7CE"
                isBold="true"/>

        </conditionalStyle>


        <!-- APPROVED -->

        <conditionalStyle>

            <conditionExpression><![CDATA[
                "APPROVED".equals($F{status})
            ]]></conditionExpression>

            <style
                forecolor="#006100"
                backcolor="#E2F0D9"
                isBold="true"/>

        </conditionalStyle>

    </style>


    <!-- ================================================= -->
    <!-- 6. GROUPING                                     -->
    <!-- ================================================= -->

    <group
        name="BankGroup"
        isStartNewPage="false">


        <!-- GROUP EXPRESSION -->

        <groupExpression><![CDATA[
            $F{bank_name}
        ]]></groupExpression>


        <!-- GROUP HEADER -->

        <groupHeader>

            <band height="28">

                <textField>

                    <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="28"/>

                    <textElement>

                        <font
                            size="12"
                            isBold="true"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        "Bank: " + $F{bank_name}
                    ]]></textFieldExpression>

                </textField>

            </band>

        </groupHeader>


        <!-- GROUP FOOTER -->

        <groupFooter>

            <band height="25">


                <textField>

                    <reportElement
                        x="450"
                        y="0"
                        width="150"
                        height="25"/>

                    <textElement textAlignment="Right"/>

                    <textFieldExpression><![CDATA[
                        "Bank Cheques: " + $V{BankChequeCount}
                    ]]></textFieldExpression>

                </textField>


                <textField pattern="#,##0.00">

                    <reportElement
                        x="600"
                        y="0"
                        width="182"
                        height="25"/>

                    <textElement textAlignment="Right"/>

                    <textFieldExpression><![CDATA[
                        $V{BankAmount}
                    ]]></textFieldExpression>

                </textField>


            </band>

        </groupFooter>

    </group>


    <!-- ================================================= -->
    <!-- 7. GROUP VARIABLES                              -->
    <!-- ================================================= -->

    <variable
        name="BankChequeCount"
        class="java.lang.Integer"
        calculation="Count"
        resetType="Group"
        resetGroup="BankGroup">

        <variableExpression><![CDATA[
            $F{cheque_number}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            0
        ]]></initialValueExpression>

    </variable>


    <variable
        name="BankAmount"
        class="java.math.BigDecimal"
        calculation="Sum"
        resetType="Group"
        resetGroup="BankGroup">

        <variableExpression><![CDATA[
            $F{cheque_amount}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            new java.math.BigDecimal("0")
        ]]></initialValueExpression>

    </variable>


    <!-- ================================================= -->
    <!-- 8. TITLE                                        -->
    <!-- ================================================= -->

    <title>

        <band height="60">


            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="30"/>

                <textElement textAlignment="Center">

                    <font
                        size="20"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    CTS - High Value Cheque Report
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="0"
                    y="35"
                    width="782"
                    height="20"/>

                <textElement textAlignment="Center"/>

                <textFieldExpression><![CDATA[
                    "High Value Amount >= " + $P{P_MIN_AMOUNT}
                ]]></textFieldExpression>

            </textField>


        </band>

    </title>


    <!-- ================================================= -->
    <!-- 9. PAGE HEADER                                  -->
    <!-- ================================================= -->

    <pageHeader>

        <band height="25">

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="400"
                    height="20"/>

                <text><![CDATA[
                    High Value Cheque Processing Report
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="650"
                    y="0"
                    width="132"
                    height="20"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>

        </band>

    </pageHeader>


    <!-- ================================================= -->
    <!-- 10. COLUMN HEADER                               -->
    <!-- ================================================= -->

    <columnHeader>

        <band height="30">


            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="0"
                    y="0"
                    width="120"
                    height="30"/>

                <text><![CDATA[
                    Cheque No
                ]]></text>

            </staticText>


            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="120"
                    y="0"
                    width="180"
                    height="30"/>

                <text><![CDATA[
                    Customer
                ]]></text>

            </staticText>


            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="300"
                    y="0"
                    width="160"
                    height="30"/>

                <text><![CDATA[
                    Bank
                ]]></text>

            </staticText>


            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="460"
                    y="0"
                    width="160"
                    height="30"/>

                <text><![CDATA[
                    Amount
                ]]></text>

            </staticText>


            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="620"
                    y="0"
                    width="162"
                    height="30"/>

                <text><![CDATA[
                    Status
                ]]></text>

            </staticText>


        </band>

    </columnHeader>


    <!-- ================================================= -->
    <!-- 11. DETAIL                                      -->
    <!-- ================================================= -->

    <detail>

        <band height="30">


            <!-- CHEQUE NUMBER -->

            <textField>

                <reportElement
                    x="0"
                    y="0"
                    width="120"
                    height="30"/>

                <textFieldExpression><![CDATA[
                    $F{cheque_number}
                ]]></textFieldExpression>

            </textField>


            <!-- CUSTOMER -->

            <textField>

                <reportElement
                    x="120"
                    y="0"
                    width="180"
                    height="30"/>

                <textFieldExpression><![CDATA[
                    $F{customer_name}
                ]]></textFieldExpression>

            </textField>


            <!-- BANK -->

            <textField>

                <reportElement
                    x="300"
                    y="0"
                    width="160"
                    height="30"/>

                <textFieldExpression><![CDATA[
                    $F{bank_name}
                ]]></textFieldExpression>

            </textField>


            <!-- AMOUNT FORMATTING -->

            <textField pattern="#,##0.00">

                <reportElement
                    x="460"
                    y="0"
                    width="160"
                    height="30"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression><![CDATA[
                    $F{cheque_amount}
                ]]></textFieldExpression>

            </textField>


            <!-- STATUS + CONDITIONAL FORMATTING -->

            <textField>

                <reportElement
                    style="StatusStyle"
                    x="620"
                    y="0"
                    width="162"
                    height="30"/>

                <textElement textAlignment="Center"/>

                <textFieldExpression><![CDATA[
                    $F{status}
                ]]></textFieldExpression>

            </textField>


        </band>

    </detail>


    <!-- ================================================= -->
    <!-- 12. COLUMN FOOTER                               -->
    <!-- ================================================= -->

    <columnFooter>

        <band height="20"/>

    </columnFooter>


    <!-- ================================================= -->
    <!-- 13. PAGE FOOTER                                 -->
    <!-- ================================================= -->

    <pageFooter>

        <band height="25">


            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="300"
                    height="20"/>

                <text><![CDATA[
                    CTS JasperReports
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="650"
                    y="0"
                    width="132"
                    height="20"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>


        </band>

    </pageFooter>


    <!-- ================================================= -->
    <!-- 14. SUMMARY                                     -->
    <!-- ================================================= -->

    <summary>

        <band height="90">


            <!-- TOTAL HIGH VALUE CHEQUES -->

            <staticText>

                <reportElement
                    x="0"
                    y="10"
                    width="250"
                    height="25"/>

                <textElement>

                    <font
                        size="12"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    Total High Value Cheques:
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="250"
                    y="10"
                    width="100"
                    height="25"/>

                <textElement>

                    <font
                        size="12"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $V{TotalHighValueCheques}
                ]]></textFieldExpression>

            </textField>


            <!-- TOTAL HIGH VALUE AMOUNT -->

            <staticText>

                <reportElement
                    x="0"
                    y="45"
                    width="250"
                    height="25"/>

                <textElement>

                    <font
                        size="12"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    Total High Value Amount:
                ]]></text>

            </staticText>


            <textField pattern="#,##0.00">

                <reportElement
                    x="250"
                    y="45"
                    width="200"
                    height="25"/>

                <textElement>

                    <font
                        size="12"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $V{TotalHighValueAmount}
                ]]></textFieldExpression>

            </textField>


        </band>

    </summary>


</jasperReport>