<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="high_value_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="742"
    leftMargin="50"
    rightMargin="50"
    topMargin="30"
    bottomMargin="30">

    <!-- ==================== STYLES ==================== -->

    <style
        name="HeaderStyle"
        forecolor="#FFFFFF"
        backcolor="#1F4E78"
        mode="Opaque"
        fontName="SansSerif"
        fontSize="10"
        isBold="true"/>

    <style
        name="GroupStyle"
        backcolor="#D9EAF7"
        mode="Opaque"
        fontName="SansSerif"
        fontSize="11"
        isBold="true"/>

    <style
        name="TotalStyle"
        backcolor="#EAF2F8"
        mode="Opaque"
        fontName="SansSerif"
        fontSize="9"
        isBold="true"/>


    <!-- ==================== PARAMETER ==================== -->

    <parameter
        name="P_MIN_AMOUNT"
        class="java.math.BigDecimal">

        <defaultValueExpression><![CDATA[
            new java.math.BigDecimal("200000")
        ]]></defaultValueExpression>

    </parameter>


    <!-- ==================== QUERY ==================== -->

    <queryString language="SQL"><![CDATA[
        SELECT
            cheque_number,
            customer_name,
            bank_name,
            cheque_amount,
            status
        FROM cheque_transaction
        WHERE cheque_amount >= $P{P_MIN_AMOUNT}
        ORDER BY bank_name, cheque_amount DESC
    ]]></queryString>


    <!-- ==================== FIELDS ==================== -->

    <field
        name="cheque_number"
        class="java.lang.String"/>

    <field
        name="customer_name"
        class="java.lang.String"/>

    <field
        name="bank_name"
        class="java.lang.String"/>

    <field
        name="cheque_amount"
        class="java.math.BigDecimal"/>

    <field
        name="status"
        class="java.lang.String"/>


    <!-- ==================== VARIABLES ==================== -->

    <variable
        name="TotalHighValueCheques"
        class="java.lang.Integer"
        calculation="Count">

        <variableExpression><![CDATA[
            $F{cheque_number}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            0
        ]]></initialValueExpression>

    </variable>


    <variable
        name="TotalHighValueAmount"
        class="java.math.BigDecimal"
        calculation="Sum">

        <variableExpression><![CDATA[
            $F{cheque_amount}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            new java.math.BigDecimal("0")
        ]]></initialValueExpression>

    </variable>


    <variable
        name="BankChequeCount"
        class="java.lang.Integer"
        calculation="Count"
        resetType="Group"
        resetGroup="BankGroup">

        <variableExpression><![CDATA[
            $F{cheque_number}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            0
        ]]></initialValueExpression>

    </variable>


    <variable
        name="BankAmount"
        class="java.math.BigDecimal"
        calculation="Sum"
        resetType="Group"
        resetGroup="BankGroup">

        <variableExpression><![CDATA[
            $F{cheque_amount}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            new java.math.BigDecimal("0")
        ]]></initialValueExpression>

    </variable>


    <!-- ==================== BANK GROUP ==================== -->

    <group
        name="BankGroup"
        isStartNewPage="false">

        <groupExpression><![CDATA[
            $F{bank_name}
        ]]></groupExpression>


        <!-- GROUP HEADER -->

        <groupHeader>

            <band height="26">

                <textField>

                    <reportElement
                        x="0"
                        y="0"
                        width="742"
                        height="26"
                        style="GroupStyle"/>

                    <textElement
                        verticalAlignment="Middle">

                        <paragraph leftIndent="8"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        "Bank: " +
                        ($F{bank_name} == null ? "" : $F{bank_name})
                    ]]></textFieldExpression>

                </textField>

            </band>

        </groupHeader>


        <!-- GROUP FOOTER -->

        <groupFooter>

            <band height="24">

                <staticText>

                    <reportElement
                        x="430"
                        y="0"
                        width="150"
                        height="24"
                        style="TotalStyle"/>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle"/>

                    <text><![CDATA[
                        Bank Total:
                    ]]></text>

                </staticText>


                <textField>

                    <reportElement
                        x="580"
                        y="0"
                        width="55"
                        height="24"
                        style="TotalStyle"/>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle"/>

                    <textFieldExpression><![CDATA[
                        $V{BankChequeCount}
                    ]]></textFieldExpression>

                </textField>


                <textField pattern="#,##0.00">

                    <reportElement
                        x="635"
                        y="0"
                        width="107"
                        height="24"
                        style="TotalStyle"/>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle"/>

                    <textFieldExpression><![CDATA[
                        $V{BankAmount}
                    ]]></textFieldExpression>

                </textField>

            </band>

        </groupFooter>

    </group>


    <!-- ==================== TITLE ==================== -->

    <title>

        <band height="65">

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="742"
                    height="32"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="18"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    CTS - High Value Cheque Report
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="0"
                    y="36"
                    width="742"
                    height="22"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="10"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "Minimum Amount: " + $P{P_MIN_AMOUNT}
                ]]></textFieldExpression>

            </textField>

        </band>

    </title>


    <!-- ==================== PAGE HEADER ==================== -->

    <pageHeader>

        <band height="22">

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="500"
                    height="20"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    High Value Cheque Processing Report
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="642"
                    y="0"
                    width="100"
                    height="20"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>

        </band>

    </pageHeader>


    <!-- ==================== COLUMN HEADER ==================== -->

    <columnHeader>

        <band height="28">

            <!-- CHEQUE NO -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="0"
                    y="0"
                    width="100"
                    height="28"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Cheque No
                ]]></text>

            </staticText>


            <!-- CUSTOMER -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="100"
                    y="0"
                    width="170"
                    height="28"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Customer
                ]]></text>

            </staticText>


            <!-- BANK -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="270"
                    y="0"
                    width="160"
                    height="28"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Bank
                ]]></text>

            </staticText>


            <!-- AMOUNT -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="430"
                    y="0"
                    width="130"
                    height="28"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Amount
                ]]></text>

            </staticText>


            <!-- STATUS -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="560"
                    y="0"
                    width="182"
                    height="28"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Status
                ]]></text>

            </staticText>

        </band>

    </columnHeader>


    <!-- ==================== DETAIL ==================== -->

    <detail>

        <band height="26">

            <!-- CHEQUE NUMBER -->

            <textField>

                <reportElement
                    x="0"
                    y="0"
                    width="100"
                    height="26"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{cheque_number}
                ]]></textFieldExpression>

            </textField>


            <!-- CUSTOMER -->

            <textField>

                <reportElement
                    x="100"
                    y="0"
                    width="170"
                    height="26"/>

                <textElement
                    verticalAlignment="Middle">

                    <paragraph leftIndent="5"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $F{customer_name}
                ]]></textFieldExpression>

            </textField>


            <!-- BANK -->

            <textField>

                <reportElement
                    x="270"
                    y="0"
                    width="160"
                    height="26"/>

                <textElement
                    verticalAlignment="Middle">

                    <paragraph leftIndent="5"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $F{bank_name}
                ]]></textFieldExpression>

            </textField>


            <!-- AMOUNT -->

            <textField pattern="#,##0.00">

                <reportElement
                    x="430"
                    y="0"
                    width="130"
                    height="26"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <paragraph rightIndent="8"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $F{cheque_amount}
                ]]></textFieldExpression>

            </textField>


            <!-- STATUS -->

            <textField>

                <reportElement
                    x="560"
                    y="0"
                    width="182"
                    height="26"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $F{status}
                ]]></textFieldExpression>

            </textField>

        </band>

    </detail>


    <!-- ==================== COLUMN FOOTER ==================== -->

    <columnFooter>

        <band height="10"/>

    </columnFooter>


    <!-- ==================== PAGE FOOTER ==================== -->

    <pageFooter>

        <band height="22">

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="300"
                    height="20"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <text><![CDATA[
                    CTS JasperReports
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="642"
                    y="0"
                    width="100"
                    height="20"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>

        </band>

    </pageFooter>


    <!-- ==================== SUMMARY ==================== -->

    <summary>

        <band height="72">

            <!-- TOTAL CHEQUES -->

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="220"
                    height="25"
                    style="TotalStyle"/>

                <textElement
                    verticalAlignment="Middle">

                    <paragraph leftIndent="8"/>

                </textElement>

                <text><![CDATA[
                    Total High Value Cheques
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="220"
                    y="0"
                    width="70"
                    height="25"
                    style="TotalStyle"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $V{TotalHighValueCheques}
                ]]></textFieldExpression>

            </textField>


            <!-- TOTAL AMOUNT -->

            <staticText>

                <reportElement
                    x="310"
                    y="0"
                    width="200"
                    height="25"
                    style="TotalStyle"/>

                <textElement
                    verticalAlignment="Middle">

                    <paragraph leftIndent="8"/>

                </textElement>

                <text><![CDATA[
                    Total High Value Amount
                ]]></text>

            </staticText>


            <textField pattern="#,##0.00">

                <reportElement
                    x="510"
                    y="0"
                    width="232"
                    height="25"
                    style="TotalStyle"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <paragraph rightIndent="8"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $V{TotalHighValueAmount}
                ]]></textFieldExpression>

            </textField>


            <!-- MINIMUM AMOUNT -->

            <staticText>

                <reportElement
                    x="0"
                    y="35"
                    width="220"
                    height="25"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                    <paragraph leftIndent="8"/>

                </textElement>

                <text><![CDATA[
                    Minimum Amount
                ]]></text>

            </staticText>


            <textField pattern="#,##0.00">

                <reportElement
                    x="220"
                    y="35"
                    width="150"
                    height="25"/>

                <textElement
                    verticalAlignment="Middle">

                    <paragraph leftIndent="5"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $P{P_MIN_AMOUNT}
                ]]></textFieldExpression>

            </textField>

        </band>

    </summary>

</jasperReport>