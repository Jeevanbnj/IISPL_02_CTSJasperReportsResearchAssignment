<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="high_value_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="30"
    bottomMargin="30">

    <!-- ========================================================= -->
    <!-- 1. STYLES                                                 -->
    <!-- ========================================================= -->

    <!-- Main table header style -->
    <style
        name="HeaderStyle"
        forecolor="#FFFFFF"
        backcolor="#1F4E78"
        mode="Opaque">

        <font
            fontName="SansSerif"
            size="10"
            isBold="true"/>

    </style>


    <!-- Status style -->
    <style name="StatusStyle">

        <!-- REJECTED -->
        <conditionalStyle>

            <conditionExpression><![CDATA[
                "REJECTED".equalsIgnoreCase(
                    $F{status} == null ? "" : $F{status}
                )
            ]]></conditionExpression>

            <style
                forecolor="#9C0006"
                backcolor="#FFC7CE"
                mode="Opaque"
                isBold="true"/>

        </conditionalStyle>


        <!-- APPROVED -->
        <conditionalStyle>

            <conditionExpression><![CDATA[
                "APPROVED".equalsIgnoreCase(
                    $F{status} == null ? "" : $F{status}
                )
            ]]></conditionExpression>

            <style
                forecolor="#006100"
                backcolor="#E2F0D9"
                mode="Opaque"
                isBold="true"/>

        </conditionalStyle>

    </style>


    <!-- Normal total style -->
    <style
        name="TotalStyle"
        backcolor="#D9EAF7"
        mode="Opaque">

        <font
            fontName="SansSerif"
            size="10"
            isBold="true"/>

    </style>


    <!-- ========================================================= -->
    <!-- 2. PARAMETERS                                              -->
    <!-- ========================================================= -->

    <parameter
        name="P_MIN_AMOUNT"
        class="java.math.BigDecimal">

        <defaultValueExpression><![CDATA[
            new java.math.BigDecimal("200000")
        ]]></defaultValueExpression>

    </parameter>


    <!-- ========================================================= -->
    <!-- 3. SQL QUERY                                               -->
    <!-- ========================================================= -->

    <queryString language="SQL"><![CDATA[
        SELECT
            cheque_number,
            customer_name,
            bank_name,
            cheque_amount,
            status
        FROM cheque_transaction
        WHERE cheque_amount >= $P{P_MIN_AMOUNT}
        ORDER BY bank_name, cheque_amount DESC
    ]]></queryString>


    <!-- ========================================================= -->
    <!-- 4. FIELDS                                                  -->
    <!-- ========================================================= -->

    <field
        name="cheque_number"
        class="java.lang.String"/>

    <field
        name="customer_name"
        class="java.lang.String"/>

    <field
        name="bank_name"
        class="java.lang.String"/>

    <field
        name="cheque_amount"
        class="java.math.BigDecimal"/>

    <field
        name="status"
        class="java.lang.String"/>


    <!-- ========================================================= -->
    <!-- 5. VARIABLES                                               -->
    <!-- ========================================================= -->

    <!-- Overall cheque count -->
    <variable
        name="TotalHighValueCheques"
        class="java.lang.Integer"
        calculation="Count">

        <variableExpression><![CDATA[
            $F{cheque_number}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            0
        ]]></initialValueExpression>

    </variable>


    <!-- Overall amount -->
    <variable
        name="TotalHighValueAmount"
        class="java.math.BigDecimal"
        calculation="Sum">

        <variableExpression><![CDATA[
            $F{cheque_amount}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            new java.math.BigDecimal("0")
        ]]></initialValueExpression>

    </variable>


    <!-- Bank cheque count -->
    <variable
        name="BankChequeCount"
        class="java.lang.Integer"
        calculation="Count"
        resetType="Group"
        resetGroup="BankGroup">

        <variableExpression><![CDATA[
            $F{cheque_number}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            0
        ]]></initialValueExpression>

    </variable>


    <!-- Bank amount -->
    <variable
        name="BankAmount"
        class="java.math.BigDecimal"
        calculation="Sum"
        resetType="Group"
        resetGroup="BankGroup">

        <variableExpression><![CDATA[
            $F{cheque_amount}
        ]]></variableExpression>

        <initialValueExpression><![CDATA[
            new java.math.BigDecimal("0")
        ]]></initialValueExpression>

    </variable>


    <!-- ========================================================= -->
    <!-- 6. GROUP                                                   -->
    <!-- ========================================================= -->

    <group
        name="BankGroup"
        isStartNewPage="false">

        <!-- Group expression -->
        <groupExpression><![CDATA[
            $F{bank_name}
        ]]></groupExpression>


        <!-- ================= GROUP HEADER ================= -->

        <groupHeader>

            <band height="30">

                <textField>

                    <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="30"
                        backcolor="#D9EAF7"
                        mode="Opaque"/>

                    <textElement
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="12"
                            isBold="true"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        "Bank: " +
                        ($F{bank_name} == null ? "" : $F{bank_name})
                    ]]></textFieldExpression>

                </textField>

            </band>

        </groupHeader>


        <!-- ================= GROUP FOOTER ================= -->

        <groupFooter>

            <band height="30">

                <!-- Bank count -->

                <staticText>

                    <reportElement
                        x="400"
                        y="0"
                        width="180"
                        height="25"
                        style="TotalStyle"/>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle"/>

                    <text><![CDATA[
                        Bank Cheques:
                    ]]></text>

                </staticText>


                <textField>

                    <reportElement
                        x="580"
                        y="0"
                        width="70"
                        height="25"
                        style="TotalStyle"/>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle"/>

                    <textFieldExpression><![CDATA[
                        $V{BankChequeCount}
                    ]]></textFieldExpression>

                </textField>


                <!-- Bank amount -->

                <textField pattern="#,##0.00">

                    <reportElement
                        x="650"
                        y="0"
                        width="132"
                        height="25"
                        style="TotalStyle"/>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle"/>

                    <textFieldExpression><![CDATA[
                        $V{BankAmount}
                    ]]></textFieldExpression>

                </textField>

            </band>

        </groupFooter>

    </group>


    <!-- ========================================================= -->
    <!-- 7. TITLE                                                   -->
    <!-- ========================================================= -->

    <title>

        <band height="70">

            <!-- Report title -->

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="35"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="20"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    CTS - High Value Cheque Report
                ]]></text>

            </staticText>


            <!-- Minimum amount -->

            <textField pattern="#,##0.00">

                <reportElement
                    x="0"
                    y="40"
                    width="782"
                    height="25"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="11"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "High Value Amount >= " + $P{P_MIN_AMOUNT}
                ]]></textFieldExpression>

            </textField>

        </band>

    </title>


    <!-- ========================================================= -->
    <!-- 8. PAGE HEADER                                             -->
    <!-- ========================================================= -->

    <pageHeader>

        <band height="25">

            <!-- Left text -->

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="500"
                    height="20"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    High Value Cheque Processing Report
                ]]></text>

            </staticText>


            <!-- Page number -->

            <textField>

                <reportElement
                    x="650"
                    y="0"
                    width="132"
                    height="20"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>

        </band>

    </pageHeader>


    <!-- ========================================================= -->
    <!-- 9. COLUMN HEADER                                           -->
    <!-- ========================================================= -->

    <columnHeader>

        <band height="30">

            <!-- Cheque Number -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="0"
                    y="0"
                    width="120"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Cheque No
                ]]></text>

            </staticText>


            <!-- Customer -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="120"
                    y="0"
                    width="180"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Customer
                ]]></text>

            </staticText>


            <!-- Bank -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="300"
                    y="0"
                    width="160"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Bank
                ]]></text>

            </staticText>


            <!-- Amount -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="460"
                    y="0"
                    width="160"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Amount
                ]]></text>

            </staticText>


            <!-- Status -->

            <staticText>

                <reportElement
                    style="HeaderStyle"
                    x="620"
                    y="0"
                    width="162"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <text><![CDATA[
                    Status
                ]]></text>

            </staticText>

        </band>

    </columnHeader>


    <!-- ========================================================= -->
    <!-- 10. DETAIL                                                 -->
    <!-- ========================================================= -->

    <detail>

        <band height="30">

            <!-- ================================================= -->
            <!-- CHEQUE NUMBER                                      -->
            <!-- ================================================= -->

            <textField>

                <reportElement
                    x="0"
                    y="0"
                    width="120"
                    height="30"/>

                <textElement
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{cheque_number}
                ]]></textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- CUSTOMER                                           -->
            <!-- ================================================= -->

            <textField>

                <reportElement
                    x="120"
                    y="0"
                    width="180"
                    height="30"/>

                <textElement
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{customer_name}
                ]]></textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- BANK                                               -->
            <!-- ================================================= -->

            <textField>

                <reportElement
                    x="300"
                    y="0"
                    width="160"
                    height="30"/>

                <textElement
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{bank_name}
                ]]></textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- AMOUNT                                             -->
            <!-- ================================================= -->

            <textField pattern="#,##0.00">

                <reportElement
                    x="460"
                    y="0"
                    width="160"
                    height="30"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{cheque_amount}
                ]]></textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- STATUS                                             -->
            <!-- ================================================= -->

            <textField>

                <reportElement
                    style="StatusStyle"
                    x="620"
                    y="0"
                    width="162"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="10"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $F{status}
                ]]></textFieldExpression>

            </textField>

        </band>

    </detail>


    <!-- ========================================================= -->
    <!-- 11. COLUMN FOOTER                                          -->
    <!-- ========================================================= -->

    <columnFooter>

        <band height="20"/>

    </columnFooter>


    <!-- ========================================================= -->
    <!-- 12. PAGE FOOTER                                            -->
    <!-- ========================================================= -->

    <pageFooter>

        <band height="25">

            <!-- Footer title -->

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="300"
                    height="20"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"/>

                </textElement>

                <text><![CDATA[
                    CTS JasperReports
                ]]></text>

            </staticText>


            <!-- Page number -->

            <textField>

                <reportElement
                    x="650"
                    y="0"
                    width="132"
                    height="20"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>

        </band>

    </pageFooter>


    <!-- ========================================================= -->
    <!-- 13. SUMMARY                                                -->
    <!-- ========================================================= -->

    <summary>

        <band height="100">

            <!-- Summary background -->

            <rectangle>

                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="90"
                    backcolor="#F2F2F2"
                    mode="Opaque"/>

            </rectangle>


            <!-- ================================================= -->
            <!-- TOTAL CHEQUES                                      -->
            <!-- ================================================= -->

            <staticText>

                <reportElement
                    x="20"
                    y="15"
                    width="250"
                    height="25"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="12"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    Total High Value Cheques:
                ]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="270"
                    y="15"
                    width="100"
                    height="25"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="12"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $V{TotalHighValueCheques}
                ]]></textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- TOTAL AMOUNT                                       -->
            <!-- ================================================= -->

            <staticText>

                <reportElement
                    x="400"
                    y="15"
                    width="200"
                    height="25"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="12"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    Total High Value Amount:
                ]]></text>

            </staticText>


            <textField pattern="#,##0.00">

                <reportElement
                    x="600"
                    y="15"
                    width="162"
                    height="25"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="12"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $V{TotalHighValueAmount}
                ]]></textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- REPORT CRITERIA                                    -->
            <!-- ================================================= -->

            <staticText>

                <reportElement
                    x="20"
                    y="55"
                    width="250"
                    height="20"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[
                    Minimum Amount:
                ]]></text>

            </staticText>


            <textField pattern="#,##0.00">

                <reportElement
                    x="270"
                    y="55"
                    width="150"
                    height="20"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    $P{P_MIN_AMOUNT}
                ]]></textFieldExpression>

            </textField>

        </band>

    </summary>

</jasperReport>