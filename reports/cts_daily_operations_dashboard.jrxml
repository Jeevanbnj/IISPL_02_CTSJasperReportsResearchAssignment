<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="cts_daily_operations_dashboard"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="792"
    leftMargin="25"
    rightMargin="25"
    topMargin="20"
    bottomMargin="20">


    <parameter name="P_PROCESSING_DAILY_DATE" class="java.sql.Date"/>

    <queryString language="SQL"><![CDATA[
        SELECT
            (SELECT COUNT(*)
             FROM cheque_transaction
             WHERE processing_date = $P{P_PROCESSING_DAILY_DATE})
             AS total_cheques,

            (SELECT COUNT(*)
             FROM cheque_transaction
             WHERE processing_date = $P{P_PROCESSING_DAILY_DATE}
             AND status = 'APPROVED')
             AS approved_cheques,

            (SELECT COUNT(*)
             FROM cheque_transaction
             WHERE processing_date = $P{P_PROCESSING_DAILY_DATE}
             AND status = 'REJECTED')
             AS rejected_cheques,

            (SELECT COUNT(*)
             FROM cheque_transaction
             WHERE processing_date = $P{P_PROCESSING_DAILY_DATE}
             AND micr_status = 'INVALID')
             AS micr_repair_pending,

            (SELECT COUNT(*)
             FROM cheque_transaction
             WHERE processing_date = $P{P_PROCESSING_DAILY_DATE}
             AND cheque_amount >= 200000)
             AS high_value_cheques,

            (SELECT SUM(cheque_amount)
             FROM cheque_transaction
             WHERE processing_date = $P{P_PROCESSING_DAILY_DATE})
             AS total_processing_amount
    ]]></queryString>

    <field name="total_cheques" class="java.lang.Long"/>
    <field name="approved_cheques" class="java.lang.Long"/>
    <field name="rejected_cheques" class="java.lang.Long"/>
    <field name="micr_repair_pending" class="java.lang.Long"/>
    <field name="high_value_cheques" class="java.lang.Long"/>
    <field name="total_processing_amount" class="java.math.BigDecimal"/>

    <title>
        <band height="70">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="792"
                    height="32"/>
                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">
                    <font size="22" isBold="true"/>
                </textElement>
                <text><![CDATA[
                    CTS - Daily Operations Dashboard
                ]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="0"
                    y="36"
                    width="125"
                    height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[
                    Processing Date:
                ]]></text>
            </staticText>

            <textField pattern="dd-MM-yyyy">
                <reportElement
                    x="125"
                    y="36"
                    width="120"
                    height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $P{P_PROCESSING_DAILY_DATE}
                ]]></textFieldExpression>
            </textField>

            <line>
                <reportElement
                    x="0"
                    y="66"
                    width="792"
                    height="1"/>
            </line>

        </band>
    </title>

    <detail>
