                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{rejected_cheques}
                ]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement
                    x="0"
