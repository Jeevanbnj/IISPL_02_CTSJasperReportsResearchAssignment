                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="0"
                    y="195"
                    width="792"
                    height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[
                    Cheque Status Summary
                ]]></text>
            </staticText>


        </band>
    </detail>

    <pageFooter>

        <band height="25">

            <textField>

                <reportElement
                    x="0"
                    y="3"
                    width="500"
                    height="18"/>

                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    "CTS Reporting | Daily Operations Dashboard"
                ]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement
                    x="650"
