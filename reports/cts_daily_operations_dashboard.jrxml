                    verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{micr_repair_pending}
                ]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement
                    x="271"
                    y="100"
                    width="250"
                    height="78"/>
            </rectangle>

            <staticText>
                <reportElement
                    x="286"
                    y="110"
                    width="220"
                    height="22"/>
                <textElement
