                    verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[
                    High Value Cheques
                ]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="286"
                    y="135"
                    width="220"
                    height="32"/>
                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{high_value_cheques}
                ]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement
                    x="542"
                    y="100"
                    width="250"
                    height="78"/>
            </rectangle>

            <staticText>
